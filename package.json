{
  "name": "skill-solar-system",
  "version": "0.4.0",
  "private": true,
  "description": "An offline, editable 3D reference atlas",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "local.skillsolarsystem.atlas",
    "productName": "Skill Solar System",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "Skill-Solar-System-${version}-${arch}.${ext}"
  }
}
